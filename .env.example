# Copy to .env and configure exact public HTTPS origins.
IDP_BASE_URL=https://idp.example.org
IDP_ISSUER=https://idp.example.org
# Optional exact hostname -> fixed client URL redirects; empty or {} disables them.
# Hostnames contain no scheme, port or path. Use lowercase hostnames consistently.
HOST_REDIRECTS='{}'
# Example: HOST_REDIRECTS='{"core.vchrist.at":"https://client.example.org/"}'
# Exact client-to-callback registry. No implicit localhost/private-network exceptions.
IDP_CLIENTS='{"minimal-mfa-app":["https://app.example.org/auth/callback"]}'
# Native startup requires an existing 32-byte binary AES key.
# Compose mounts /app/keys/totp.key; provision it before starting an existing deployment.
TOTP_KEY_PATH=/absolute/path/to/totp.key
# Google only; both credentials must be nonempty to enable federation.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Fixed operator-configured command; read To from message headers, e.g. msmtp -t.
# Empty/failing delivery never discloses a reset link in the browser or logs.
SMTP_COMMAND=
# Docker build metadata: supply the revision actually being built.
AUTH_REVISION=unknown
